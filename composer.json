{
    "name": "indianopinion/gen-queue",
    "description": "WordPress job queue for paid generation work: daily spend cap, kill switch, retries with backoff, cooldowns, per-attempt cost records and a status page.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "queue", "jobs", "spend cap", "kill switch", "wp-cli"],
    "homepage": "https://github.com/IndianOpinion/gen-queue",
    "support": {
        "issues": "https://github.com/IndianOpinion/gen-queue/issues",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\GenQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\GenQueue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable"
}
